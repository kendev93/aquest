#!/bin/sh

# 提交前只跑秒级静态检查（格式 + lint）。
# 完整测试套件留给 pre-push 与 CI，避免每次 commit 等十几分钟。

set -eu

REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$REPO_ROOT"

if command -v python >/dev/null 2>&1; then
  python_bin=python
else
  python_bin=python3
fi

"$python_bin" -m ruff format --check aquest tests
"$python_bin" -m ruff check aquest tests
