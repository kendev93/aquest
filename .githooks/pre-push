#!/bin/sh

# 推送前确保 Python 核心检查（全量测试 + 覆盖率、格式、Ruff、mypy）验证过要推的内容。
# 前端 E2E 与 Docker 检查体积大、耗时长，交给 CI 执行。
#
# 检查是按代码内容盖章的：`sh scripts/verify_ci.sh python` 通过后就代表这一份代码验证
# 过了，之后无论推几次、网络失败重推几轮都不会再跑一遍。只有要推的 commit 变了才重跑。
# 想无条件重跑：AQUEST_VERIFY_FORCE=1 git push

set -eu

REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$REPO_ROOT"

. "$REPO_ROOT/scripts/verify_stamp.sh"

head_tree=$(git rev-parse 'HEAD^{tree}')
pushed_other_tree=0
while read -r _ref_name local_oid _remote_ref _remote_oid; do
  case "$local_oid" in
    ""|0000000000000000000000000000000000000000) continue ;;
  esac
  # annotated tag 推的是 tag 对象自己的 OID，不是 commit；先剥到 tree 再比。盖章本来
  # 就按 tree 算，内容与 HEAD 一致就该复用，推标签不该把整套检查再跑一遍。
  local_tree=$(git rev-parse --verify --quiet "${local_oid}^{tree}" || true)
  if [ "$local_tree" != "$head_tree" ]; then
    pushed_other_tree=1
  fi
done

# 推送的内容与当前 HEAD 的 tree 不一致时，盖章对不上，按未验证处理。
scopes="python frontend-fast"
if [ "$pushed_other_tree" -eq 1 ]; then
  printf '%s\n' '推送的内容与当前 HEAD 不一致，按未验证处理。' >&2
  for scope in $scopes; do
    sh "$REPO_ROOT/scripts/verify_ci.sh" "$scope"
  done
  exit 0
fi

for scope in $scopes; do
  if verify_is_fresh "$scope"; then
    printf '推送前检查：%s %s，跳过重跑（改了代码会自动重跑；AQUEST_VERIFY_FORCE=1 可强制）\n' \
      "$scope" "$(verify_describe "$scope")"
    continue
  fi
  printf '推送前检查：%s 还没验证过，开始跑。\n' "$scope"
  sh "$REPO_ROOT/scripts/verify_ci.sh" "$scope"
done
