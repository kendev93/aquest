# syntax=docker/dockerfile:1.7

FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    NUITKA_CACHE_DIR=/build/.nuitka-cache

WORKDIR /build

RUN apt-get update \
    && apt-get install --no-install-recommends -y build-essential patchelf \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-build.txt pyproject.toml README.md LICENSE THIRD_PARTY_NOTICES.md ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements.txt \
    && python -m pip install --no-cache-dir -r requirements-build.txt

COPY selector_app ./selector_app
COPY scripts/build_nuitka.py scripts/nuitka_entrypoint.py scripts/verify_nuitka_bundle.py ./scripts/

ARG NUITKA_JOBS=4
ARG NUITKA_LTO=auto
ARG NUITKA_REPRODUCIBLE=auto
RUN --mount=type=cache,target=/build/.nuitka-cache \
    python scripts/build_nuitka.py \
    --output-dir /build/release \
    --cache-dir /build/.nuitka-cache \
    --jobs "${NUITKA_JOBS}" \
    --lto "${NUITKA_LTO}" \
    --reproducible "${NUITKA_REPRODUCIBLE}"

FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates libgomp1 libstdc++6 wget \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 appuser \
    && mkdir -p /data/vipdoc /data/market /opt/indicator-lab \
    && chown -R appuser:appuser /data /opt/indicator-lab

WORKDIR /opt/indicator-lab
COPY --from=builder /build/release/indicator-lab.dist ./indicator-lab.dist
COPY --from=builder /build/LICENSE /build/THIRD_PARTY_NOTICES.md ./

RUN chown -R appuser:appuser /opt/indicator-lab
USER appuser

EXPOSE 8123

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --quiet --spider http://127.0.0.1:8123/healthz

ENTRYPOINT ["/opt/indicator-lab/indicator-lab.dist/indicator-lab"]
CMD ["server", "--host", "0.0.0.0", "--port", "8123"]
