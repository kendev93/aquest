# 行情由本机 DuckDB 保存，容器自己同步；详见 docs/standalone-deployment.md。
WEB_PORT=5173
API_PORT=8123
# Docker 必填：本地构建的镜像名，随便起一个即可（不是去拉取别人的镜像）。
# 缺了它 docker compose 会直接报错。
INDICATOR_LAB_IMAGE=indicator-lab:local
# 默认使用 1 个评估进程以降低 CPU 压力；设置 auto 可按 CPU 与内存自动分配。
SELECTOR_DISCOVERY_WORKERS=1
# Auto uses 80% of the worker/backend cgroup memory. Set an integer MiB to pin it.
SELECTOR_DISCOVERY_MEMORY_BUDGET_MB=auto
# 默认同时研究 1 只股票。
# 单股验证与风险寻优共享上述评估进程预算；设置 auto 可启用更多股票并发。
SELECTOR_STRATEGY_POOL_MAX_WORKERS=1
# Optional shared container memory cap, for example 6g or 24g. Zero means no
# Compose-level cap, so Docker Desktop's own memory allocation is used.
# STRATEGY_WORKER_MEMORY_LIMIT=6g
# 默认开启：启动后检查一次，并按上海本地日期每天自动同步一次在线行情。
# SELECTOR_AUTO_SYNC_ENABLED=0
# SELECTOR_AUTO_SYNC_CHECK_INTERVAL_SECONDS=900
# 回测 numba 内核总开关（寻优热路径与信号回测循环加速，约几十倍）。
# 默认开启；numba 不可用或执行异常时自动回退纯 Python 实现（结果一致）。
# SELECTOR_FAST_SIM=0

# 数据目录。留空用命名卷；设置后配合 docker-compose.bind.yml 落到宿主目录，
# 该目录必须允许容器内的 appuser(uid 10001) 写入。
# DATA_DIR=/srv/indicator-lab

# 整库备份保留天数。数据库有数 GB 时每份备份同样大，所以默认 0：
# 压缩期间临时保留一份用于回滚，成功后立即删除。
# SELECTOR_DB_BACKUP_RETENTION_DAYS=0
# 首次启动时若 token 文件不存在则自动生成。默认关闭：从别处挂载 token 的部署
# 在文件缺失时应当报错，而不是悄悄换成一个和 worker 不一致的密钥。
# SELECTOR_STRATEGY_WORKER_TOKEN_AUTOGENERATE=1

# Strategy Lab normally requires the Docker-installed Optuna + LightGBM pair.
# Local-only deterministic fallback for dependency diagnostics:
# INDICATOR_LAB_DISCOVERY_ALLOW_FALLBACK=1
# Optional TDX online-sync overrides.
# TDX_HOST=111.229.247.189
# TDX_PORT=7709
# TDX_KNOWN_HOSTS=111.229.247.189,150.158.160.2

# 策略池每日跟踪：收盘行情就绪后后台更新两个目标，详情只读缓存。
# SELECTOR_POOL_TRACKING_ENABLED=0

# 下面两个开关名字相近但作用不同，改之前先确认你要关的是哪一个：
#   SELECTOR_POOL_TRACKING_ENABLED     进程启动时是否自动开始上面的池跟踪；
#   SELECTOR_STRATEGY_TRACKING_ENABLED 策略追踪功能总开关（默认开启）。
# 策略追踪的检查间隔，默认 900 秒。
# SELECTOR_STRATEGY_TRACKING_ENABLED=0
# SELECTOR_STRATEGY_TRACKING_CHECK_INTERVAL_SECONDS=900
