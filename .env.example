# 行情由 ETFQuest 提供；使用 scripts/start_indicator_lab.* 自动挂载。
WEB_PORT=5173
API_PORT=8123
# Strategy discovery automatically caps concurrency by the CPUs visible to
# Docker and then lowers it again when the selected data range needs more RAM.
# Set an integer to impose a lower maximum, for example 4.
SELECTOR_DISCOVERY_WORKERS=auto
# Auto uses 80% of the worker/backend cgroup memory. Set an integer MiB to pin it.
SELECTOR_DISCOVERY_MEMORY_BUDGET_MB=auto
# Optional shared container memory cap, for example 6g or 24g. Zero means no
# Compose-level cap, so Docker Desktop's own memory allocation is used.
# STRATEGY_WORKER_MEMORY_LIMIT=6g
# 默认开启：启动后检查一次，并按上海本地日期每天自动同步一次在线行情。
# SELECTOR_AUTO_SYNC_ENABLED=0
# SELECTOR_AUTO_SYNC_CHECK_INTERVAL_SECONDS=900
# The app-owned DuckDB is stored beside ETFQuest at
# ${ETFQUEST_APP_DATA_DIR}/indicator-lab/market.duckdb and bind-mounted to /data/market.
# Indicator Lab startup scripts set ETFQUEST_APP_DATA_DIR automatically; manual Compose use must set it.
# ETFQUEST_APP_DATA_DIR=/path/to/ETFQuest
# scripts/start_indicator_lab.* creates this file with local-only permissions if missing:
# ${ETFQUEST_APP_DATA_DIR}/indicator-lab/.strategy-worker-token
# It is mounted as a read-only Compose secret to backend and strategy-worker; never commit it.
# Release/shared-data mode: ETFQuest owns the schema; the explicit sync task
# may write market_data through the shared writer.
# SELECTOR_MARKET_DATA_SOURCE=etfquest
# SELECTOR_RELEASE_MODE=1
# SELECTOR_ETFQUEST_DATABASE_PATH=/run/etfquest/database/market_data.db
# Shared-data startup scripts infer ETFQUEST_APP_DATA_DIR as the parent of
# ETFQUEST_MARKET_DATABASE_DIR (the directory containing database/ and .secret.key).
# The .secret.key bind mount is read-only and is only attached to the backend.
# Only for local development when no ETFQuest database is available.
# SELECTOR_ENABLE_LEGACY_MARKET_WRITES=1
# Full-market sync is dynamic by default; override only when needed.
# ETFQUEST_MARKET_SYNC_WORKERS=auto
# ETFQUEST_MARKET_SYNC_MAX_WORKERS=8
# ETFQUEST_MARKET_SYNC_MEMORY_BUDGET_MB=auto
# Strategy Lab normally requires the Docker-installed Optuna + LightGBM pair.
# Local-only deterministic fallback for dependency diagnostics:
# INDICATOR_LAB_DISCOVERY_ALLOW_FALLBACK=1
# Optional TDX online-sync overrides.
# TDX_HOST=111.229.247.189
# TDX_PORT=7709
# TDX_KNOWN_HOSTS=111.229.247.189,150.158.160.2

# --- 独立分发（docker-compose.standalone.yml）---------------------------------
# 整库备份保留天数。数据库有数 GB 时每份备份同样大，所以独立分发默认 0：
# 压缩期间临时留一份用于回滚，成功后立即删除。详见 docs/standalone-deployment.md
# SELECTOR_DB_BACKUP_RETENTION_DAYS=0
# 首次启动时若 token 文件不存在则自动生成（仅独立分发行启用；
# 共享模式必须由 ETFQuest 提供，缺失应当暴露为配置错误而不是被掩盖）
# SELECTOR_STRATEGY_WORKER_TOKEN_AUTOGENERATE=1
