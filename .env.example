# 行情由本机 DuckDB 保存，容器自己同步；详见 docs/standalone-deployment.md。
WEB_PORT=5173
API_PORT=8123
# Docker 必填：后端与 strategy-worker 使用的镜像名。缺了它 docker compose 会
# 直接报错。两种取值二选一：
#   本地构建（默认）：镜像只在本机，改完代码需要重建；
#   免构建启动：ghcr.io/kendev93/aquest:latest，见 README 方式一。
AQUEST_IMAGE=aquest:local
# 构建镜像时 pip 取包的源，只在重建那一步用到，不影响运行中的容器。默认官方
# https://pypi.org/simple ；不开代理时国内直连 pypi.org 会在 TLS 上被掐断，构建
# 报 "No matching distribution found"，换成镜像站就能过：
#   PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# 换源不放松校验：requirements.txt 的 --require-hashes 仍逐文件比对 sha256。
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# 默认使用 1 个评估进程以降低 CPU 压力；设置 auto 可按 CPU 与内存自动分配。
AQUEST_DISCOVERY_WORKERS=1
# Auto uses 80% of the worker/backend cgroup memory. Set an integer MiB to pin it.
AQUEST_DISCOVERY_MEMORY_BUDGET_MB=auto
# 默认同时研究 1 只股票。
# 单股验证与风险寻优共享上述评估进程预算；设置 auto 可启用更多股票并发。
AQUEST_STRATEGY_POOL_MAX_WORKERS=1
# DuckDB 查询线程数（只注入策略 worker）。研究负载里全是单标的小查询，DuckDB
# 默认按可见 CPU 数起的内部线程池只会空转吃核——单 worker 就能占满整机 CPU，
# 多开股票并发反而互相踩踏。设 1~2 把核让给真实的股票并发；行情同步/导入在
# 后端进程，不受它影响。设 0 或非法值恢复 DuckDB 默认（不建议）。
AQUEST_DUCKDB_THREADS=1
# 行情库连接的等待预算（秒，只注入策略 worker）。共享卷上 DuckDB 的读写打开是
# 独占的：backend 的读打不开就该快速失败，而研究里一次打不开就废掉整只标的、
# 白跑几分钟，所以只给 worker 放宽（0.1 秒起翻倍、单步最多 5 秒）。不设就用
# compose 里的 25；后端进程不读这个变量，页面仍然快速失败不陪跑。
AQUEST_DUCKDB_CONNECT_RETRY_SECONDS=25
# BLAS/OpenMP 线程数已在 worker 进程内默认压到 1（strategy_discovery/worker.py
# 顶部），研究负载里几乎没有它们能加速的运算。想放开时在这里显式覆盖。
# OPENBLAS_NUM_THREADS=1
# OMP_NUM_THREADS=1
# MKL_NUM_THREADS=1
# NUMEXPR_MAX_THREADS=1
# Optional shared container memory cap, for example 6g or 24g. Zero means no
# Compose-level cap, so Docker Desktop's own memory allocation is used.
# STRATEGY_WORKER_MEMORY_LIMIT=6g
# 默认开启：启动后检查一次，并按上海本地日期每天自动同步一次在线行情。
# AQUEST_AUTO_SYNC_ENABLED=0
# AQUEST_AUTO_SYNC_CHECK_INTERVAL_SECONDS=900
# 上游版本检查：默认开启，启动时查一次、之后每天查一次 GitHub Releases。只读一个
# 版本号，不下载也不执行任何东西；顶栏在有新版本时给一条可关闭的提示，升级命令仍由
# 用户自己按。离线或内网部署把它设成 off 就完全不发起这个请求；fork 部署可以把仓库
# 指到自己的 owner/name。
# AQUEST_UPDATE_CHECK=off
# AQUEST_RELEASE_REPOSITORY=kendev93/aquest
# 回测 numba 内核总开关（寻优热路径与信号回测循环加速，约几十倍）。
# 默认开启；numba 不可用或执行异常时自动回退纯 Python 实现（结果一致）。
# AQUEST_FAST_SIM=0

# 数据目录。留空用命名卷；设置后配合 docker-compose.bind.yml 落到宿主目录，
# 该目录必须允许容器内的 appuser(uid 10001) 写入。
# DATA_DIR=/srv/aquest

# 整库备份保留天数。数据库有数 GB 时每份备份同样大，所以默认 0：
# 压缩期间临时保留一份用于回滚，成功后立即删除。
# AQUEST_DB_BACKUP_RETENTION_DAYS=0
# 首次启动时若 token 文件不存在则自动生成。默认关闭：从别处挂载 token 的部署
# 在文件缺失时应当报错，而不是悄悄换成一个和 worker 不一致的密钥。
# AQUEST_STRATEGY_WORKER_TOKEN_AUTOGENERATE=1

# Strategy Lab normally requires the Docker-installed Optuna + LightGBM pair.
# Local-only deterministic fallback for dependency diagnostics:
# AQUEST_DISCOVERY_ALLOW_FALLBACK=1
# Optional TDX online-sync overrides.
# TDX_HOST=111.229.247.189
# TDX_PORT=7709
# TDX_KNOWN_HOSTS=111.229.247.189,150.158.160.2

# 策略池每日跟踪：收盘行情就绪后后台更新两个目标，详情只读缓存。
# AQUEST_POOL_TRACKING_ENABLED=0

# 到期策略自动增量研究：每天检查一次，只在有到期/待补算标的时提交全市场增量任务，
# 一天最多一次；跟随自动行情同步启动。沿用最近一次成功的手动全量研究参数（没有记录
# 时用默认值）；整池都待重算时留给手动增量。关掉它不影响手动“增量更新策略池”。
# AQUEST_POOL_RESEARCH_ENABLED=0
# 「没有策略」结论的重查周期（自然日，默认 7 天）。约 1800 只 no_strategy 按 7 天
# 分摊约 250 只/天、2.5 小时左右，长假也有余量；调成 1 天会变成约 17 小时/天并长期
# 占满机器。无论周期多长，待研究队列都按上次研究时间从旧到新排队，跑不完的次日优先补齐。
# AQUEST_POOL_NO_STRATEGY_RECHECK_DAYS=7
# 「选出候选但效果不好」的弱策略（全区间平仓不足 20 笔，或全区间跑输买入持有基准）
# 的重新寻优周期（自然日，默认 7 天，需同时满足连续 5 个交易日判弱）。约 890 只按
# 7 天分摊约 130 只/天；缩短得太多会让同一套规则被反复重选。
# AQUEST_POOL_WEAK_RECHECK_DAYS=7

# 下面两个开关名字相近但作用不同，改之前先确认你要关的是哪一个：
#   AQUEST_POOL_TRACKING_ENABLED     进程启动时是否自动开始上面的池跟踪；
#   AQUEST_STRATEGY_TRACKING_ENABLED 策略追踪功能总开关（默认开启）。
# 策略追踪的检查间隔，默认 900 秒。
# AQUEST_STRATEGY_TRACKING_ENABLED=0
# AQUEST_STRATEGY_TRACKING_CHECK_INTERVAL_SECONDS=900
