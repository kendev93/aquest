# 正常启动不需要配置 vipdoc 路径。
# 如果本机安装了通达信，可使用 docker-compose.local-vipdoc.yml
# 直接共享桌面端数据（不要在普通模式下设置此变量）：
# HOST_VIPDOC_PATH=/path/to/your/tdx/vipdoc
WEB_PORT=5173
API_PORT=8123
# 默认开启：启动后检查一次，并按上海本地日期每天自动同步一次在线行情。
# SELECTOR_AUTO_SYNC_ENABLED=0
# SELECTOR_AUTO_SYNC_CHECK_INTERVAL_SECONDS=900
# Optional override for the application-owned DuckDB data directory.
# Docker uses /data/market automatically.
# SELECTOR_DATA_DIR=/path/to/selector-data
# Strategy Lab normally requires the Docker-installed Optuna + LightGBM pair.
# Local-only deterministic fallback for dependency diagnostics:
# INDICATOR_LAB_DISCOVERY_ALLOW_FALLBACK=1
# Optional TDX online-sync overrides.
# TDX_HOST=111.229.247.189
# TDX_PORT=7709
# TDX_KNOWN_HOSTS=111.229.247.189,150.158.160.2
